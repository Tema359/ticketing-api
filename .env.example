# Application runtime environment: development, test, or production.
NODE_ENV=development

# HTTP port exposed by the NestJS application.
PORT=3000

# PostgreSQL connection URL without a password; credentials come from the secret file.
DB_URL=postgresql://ticketing@127.0.0.1:5432/ticketing

# Path to the mounted password file; the password itself must never be placed here.
DB_PASSWORD_FILE=secrets/db_password
