{
  "name": "ticketing-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ticketing API",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "openapi:generate": "npm run build && node dist/generate-openapi.js",
    "test:contract": "tsc && node --test test/contract.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "express": "^5.2.1",
    "express-openapi-validator": "5.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@redocly/cli": "2.46.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
